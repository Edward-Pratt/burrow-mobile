<?xml version="1.0" encoding="utf-8"?>
<!-- The app's private key and pinned host key never leave the phone:
     allowBackup="false" stops cloud backups, and Android 12 and later
     also need this to stop device-to-device copies. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
